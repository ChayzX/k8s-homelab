# Allow node-exporter TCP/9100 only from the Oracle IPv4 pod CIDR used by the
# in-cluster Prometheus scrape. This inet input chain runs before iptables' 0
# priority hooks, so kube-router's marked ACCEPT and Tailscale's broad accept
# cannot bypass the source restriction.
table inet pantrybot_guard {
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr != 10.42.0.0/24 tcp dport 9100 counter drop
    ip6 saddr != ::1 tcp dport 9100 counter drop
  }
}
