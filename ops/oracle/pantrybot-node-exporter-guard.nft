# Restrict host services before iptables' 0 priority hooks, so kube-router's
# marked ACCEPT and Tailscale's broad tailscale0 accept cannot bypass these
# source restrictions.
table inet pantrybot_guard {
  chain input {
    type filter hook input priority -10; policy accept;
    # App, backup, and analyze pods share this Oracle cluster CIDR. Grafana
    # connects from MinecraftMachine's verified Tailscale address.
    ip saddr != 10.42.0.0/24 ip saddr != 100.84.89.87 tcp dport 5432 counter drop
    ip6 saddr != ::1 tcp dport 5432 counter drop
    # Prometheus scrapes node-exporter from the Oracle pod CIDR only.
    ip saddr != 10.42.0.0/24 tcp dport 9100 counter drop
    ip6 saddr != ::1 tcp dport 9100 counter drop
  }
}
