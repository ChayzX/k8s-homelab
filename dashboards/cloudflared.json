{
  "uid": "homelab-cloudflared",
  "title": "Cloudflare Tunnel — cloudflared Health",
  "description": "Kubernetes and Loki visibility for the cloudflared connector that serves the dashboard-managed Cloudflare Tunnel. These panels deliberately use only signals this repository already collects: kube-state-metrics, cAdvisor, and promtail/Loki. cloudflared's native :2000 endpoint is used for probes but is not a Prometheus scrape target.",
  "tags": ["homelab", "k3s", "cloudflare", "cloudflared", "tunnel"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1, "regex": "", "skipUrlSync": false },
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "query": "loki", "current": {}, "hide": 0, "refresh": 1, "regex": "", "skipUrlSync": false },
    { "name": "pod", "label": "Connector pod", "type": "query", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "definition": "label_values({namespace=\"pantry-bot\", container=\"cloudflared\"}, pod)", "query": { "label": "pod", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "{namespace=\"pantry-bot\", container=\"cloudflared\"}", "type": 1 }, "refresh": 2, "includeAll": true, "allValue": ".+", "multi": true, "sort": 1, "hide": 0, "current": { "selected": true, "text": ["All"], "value": ["$__all"] }, "skipUrlSync": false },
    { "name": "level", "label": "Severity", "type": "custom", "query": "debug,info,warn,error", "options": [{ "selected": false, "text": "debug", "value": "debug" }, { "selected": false, "text": "info", "value": "info" }, { "selected": false, "text": "warn", "value": "warn" }, { "selected": false, "text": "error", "value": "error" }], "includeAll": true, "allValue": ".*", "multi": true, "hide": 0, "current": { "selected": true, "text": ["All"], "value": ["$__all"] }, "skipUrlSync": false }
  ] },
  "panels": [
    { "type": "row", "title": "Tunnel connectivity and lifecycle", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    { "id": 1, "type": "stat", "title": "Connector Ready", "description": "Kubernetes readiness is cloudflared's /ready endpoint. It returns 200 only after a connection is registered with Cloudflare's edge, making it more useful than merely observing a running process.", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "min(kube_pod_container_status_ready{namespace=\"pantry-bot\", container=\"cloudflared\"})", "legendFormat": "ready" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "NOT READY", "color": "red", "index": 0 }, "1": { "text": "READY", "color": "green", "index": 1 } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] } },
    { "id": 2, "type": "stat", "title": "Connector Running", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "min(kube_pod_container_status_running{namespace=\"pantry-bot\", container=\"cloudflared\"})", "legendFormat": "running" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "RUNNING", "color": "green", "index": 1 } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] } },
    { "id": 3, "type": "stat", "title": "Restarts (24h)", "description": "The liveness probe allows a 2.5-minute sustained Cloudflare-edge disconnection before restarting the connector. A nonzero value is a signal to inspect the log panels.", "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"pantry-bot\", container=\"cloudflared\"}[24h])) or vector(0)", "legendFormat": "restarts" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 1 }, { "color": "red", "value": 2 }] } }, "overrides": [] } },
    { "id": 4, "type": "stat", "title": "Deployment Desired / Ready", "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "kube_deployment_spec_replicas{namespace=\"pantry-bot\", deployment=\"cloudflared\"}", "legendFormat": "desired" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "kube_deployment_status_replicas_available{namespace=\"pantry-bot\", deployment=\"cloudflared\"}", "legendFormat": "ready" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "none", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] } },
    { "type": "row", "title": "Connector resources", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": [] },
    { "id": 5, "type": "timeseries", "title": "Memory Working Set vs Limit / Request", "description": "Solid cAdvisor working set, dashed 128Mi limit, and dotted 64Mi request.", "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"pantry-bot\", container=\"cloudflared\"})", "legendFormat": "working set" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_limits{namespace=\"pantry-bot\", container=\"cloudflared\", resource=\"memory\"})", "legendFormat": "LIMIT" }, { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_requests{namespace=\"pantry-bot\", container=\"cloudflared\", resource=\"memory\"})", "legendFormat": "request" }], "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] } },
    { "id": 6, "type": "timeseries", "title": "CPU Usage vs Limit (cores)", "description": "Solid cAdvisor CPU usage and dashed 200m CPU limit.", "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"pantry-bot\", container=\"cloudflared\"}[5m]))", "legendFormat": "usage" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_limits{namespace=\"pantry-bot\", container=\"cloudflared\", resource=\"cpu\"})", "legendFormat": "LIMIT" }], "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 3, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisLabel": "cores" } }, "overrides": [] } },
    { "type": "row", "title": "Connector logs", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "panels": [] },
    { "id": 7, "type": "timeseries", "title": "Log Volume by Severity", "description": "Zerolog severity is extracted by promtail. Warning or error spikes around an edge disconnect are visible before the connector has accumulated enough failures for a liveness restart.", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 }, "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "sum by (level) (count_over_time({namespace=\"pantry-bot\", container=\"cloudflared\", pod=~\"$pod\", level=~\"$level\"} [$__auto]))", "queryType": "range", "legendFormat": "{{level}}" }], "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["sum", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 85, "showPoints": "never", "spanNulls": false, "barAlignment": 0, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] } },
    { "id": 8, "type": "logs", "title": "cloudflared Logs", "description": "Live connector log stream. The Cloudflare warning 'accept stream listener encountered a failure' is directly visible here alongside reconnect and registration messages.", "gridPos": { "h": 12, "w": 12, "x": 12, "y": 17 }, "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{namespace=\"pantry-bot\", container=\"cloudflared\", pod=~\"$pod\", level=~\"$level\"}", "maxLines": 2000 }], "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }, "fieldConfig": { "defaults": {}, "overrides": [] } }
  ]
}
