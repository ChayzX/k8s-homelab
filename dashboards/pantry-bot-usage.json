    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bot replies sent and failed (daily)",
      "description": "Durable count of outbound bot messages by day and delivery status.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT day::timestamptz AS \"time\", status AS metric, sum(count)::bigint AS messages FROM engagement_message_counts WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY 1,2 ORDER BY 1"
