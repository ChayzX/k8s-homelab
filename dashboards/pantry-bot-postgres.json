    {
      "id": 8,
      "type": "stat",
      "title": "Boss outcomes (7d)",
      "description": "boss_events resolutions in the last seven days by status. defeated vs expired is the real outcome mix.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT status AS \"outcome\", count(*) AS \"fights\" FROM boss_events WHERE start_time > now() - interval '7 days' GROUP BY 1 ORDER BY 2 DESC",
          "rawQuery": true
