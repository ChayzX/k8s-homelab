    {
      "id": 9,
      "type": "timeseries",
      "title": "Bot messages by status (daily)",
      "description": "engagement_message_counts is a daily rollup (day/status/count) written by the bot itself — daily grain, not per-second. Use for 7d/30d ranges.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawSql": "SELECT day AS \"time\", status AS metric, sum(count)::bigint AS \"messages\" FROM engagement_message_counts WHERE day BETWEEN $__timeFrom()::date - interval '1 day' AND $__timeTo()::date GROUP BY 1,2 ORDER BY 1",
          "rawQuery": true
        }
      ],
      "options": {
        "legend": {
