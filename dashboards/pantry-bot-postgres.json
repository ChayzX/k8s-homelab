          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Outbound deliveries by target/status",
      "description": "pantry_outbox lifetime mix per dispatch target. completed is delivered; anything else (pending lease-held, retrying, dead_letter) is dispatcher backlog.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT target AS \"target\", status AS \"status\", count(*) AS \"messages\" FROM pantry_outbox GROUP BY 1,2 ORDER BY 3 DESC",
          "rawQuery": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
