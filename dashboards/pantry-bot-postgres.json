{
  "uid": "homelab-pantry-bot-postgres",
  "title": "Pantry Bot — Usage (Postgres)",
  "description": "Application usage read from Pantry Bot's PostgreSQL tables through the home standby replica (postgres-authority-home-return), which streams from the Oracle writer. No Prometheus scrape required, so this works while the home app plane is parked and Oracle holds the Twitch leases. Standby reads lag the writer by seconds; extension-route and per-command counters have no table and remain pending the /metrics-per-role code fix.",
  "tags": [
    "homelab",
    "twitch",
    "pantry-bot",
    "usage",
    "postgres"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "label": "Postgres",
        "type": "datasource",
        "query": "postgres",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Ingest — is Twitch reaching the bot?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Events ingested (1h)",
      "description": "Rows appended to pantry_events in the last hour, all sources. This is raw Twitch ingest (chat messages, redemptions, subs), not game actions.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT count(*) AS \"events\" FROM pantry_events WHERE created_at > now() - interval '1 hour'",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending events now",
      "description": "pantry_events rows still awaiting a worker. Sustained non-zero means workers are behind or stopped on the writer site.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT count(*) AS \"pending\" FROM pantry_events WHERE status = 'pending'",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dead-letter outbox",
      "description": "pantry_outbox rows that exhausted retries. Any non-zero row deserves a look at last_error on the writer.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT count(*) AS \"dead_letter\" FROM pantry_outbox WHERE status = 'dead_letter'",
          "rawQuery": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
