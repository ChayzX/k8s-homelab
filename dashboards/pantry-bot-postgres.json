    {
      "id": 7,
      "type": "stat",
      "title": "Boss damage (24h)",
      "description": "Sum of damage_dealt in boss_contributions over the last 24 hours. Real dealt damage, not the legacy donation-path counter.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "rawSql": "SELECT coalesce(sum(damage_dealt),0) AS \"damage\" FROM boss_contributions WHERE created_at > now() - interval '24 hours'",
          "rawQuery": true
