{
  "uid": "greenies-main-pc-health",
  "title": "Greenie's Main PC Health",
  "description": "Fixed view of Greenie's Windows PC, forwarded by Grafana Alloy through the protected remote-write receiver. No host selector is needed: every panel is scoped to the remote Alloy host job.",
  "tags": ["homelab", "windows", "remote", "alloy", "pc"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1 }
  ] },
  "panels": [
    { "type": "row", "title": "Greenie's Main PC — current state", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    { "id": 1, "type": "stat", "title": "Alloy Metrics Up", "description": "The Windows Alloy scrape health signal for this PC.", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "up{site=\"remote\", job=\"host\"}", "legendFormat": "remote PC" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" }, "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] } },
    { "id": 2, "type": "gauge", "title": "CPU Used", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "100 * (1 - avg(rate(windows_cpu_time_total{site=\"remote\", job=\"host\", mode=\"idle\"}[5m])))", "legendFormat": "CPU" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdMarkers": true } },
    { "id": 3, "type": "gauge", "title": "Memory Used", "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "100 * (1 - windows_memory_available_bytes{site=\"remote\", job=\"host\"} / windows_memory_physical_total_bytes{site=\"remote\", job=\"host\"})", "legendFormat": "memory" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdMarkers": true } },
    { "id": 4, "type": "stat", "title": "Uptime", "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "time() - windows_system_boot_time_timestamp{site=\"remote\", job=\"host\"}", "legendFormat": "uptime" }], "fieldConfig": { "defaults": { "unit": "dtdurations", "decimals": 1 }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" } },
    { "type": "row", "title": "CPU and memory", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": [] },
    { "id": 5, "type": "timeseries", "title": "CPU by Mode", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "100 * rate(windows_cpu_time_total{site=\"remote\", job=\"host\"}[5m])", "legendFormat": "{{mode}}" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "id": 6, "type": "timeseries", "title": "Memory Available vs Total", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "windows_memory_available_bytes{site=\"remote\", job=\"host\"}", "legendFormat": "available" }, { "refId": "B", "expr": "windows_memory_physical_total_bytes{site=\"remote\", job=\"host\"}", "legendFormat": "total" }], "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "type": "row", "title": "Disk and network", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "panels": [] },
    { "id": 7, "type": "timeseries", "title": "Logical Disk Free Space", "description": "Free bytes by Windows volume. The volume label is shown in the legend.", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "windows_logical_disk_free_bytes{site=\"remote\", job=\"host\"}", "legendFormat": "{{volume_id}}" }], "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } } },
    { "id": 8, "type": "timeseries", "title": "Network Throughput", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "rate(windows_net_bytes_received_total{site=\"remote\", job=\"host\"}[5m])", "legendFormat": "{{nic}} received" }, { "refId": "B", "expr": "rate(windows_net_bytes_sent_total{site=\"remote\", job=\"host\"}[5m])", "legendFormat": "{{nic}} sent" }], "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } } },
    { "type": "row", "title": "Windows host details", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "panels": [] },
    { "id": 9, "type": "timeseries", "title": "Disk Used by Volume", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "100 * (1 - windows_logical_disk_free_bytes{site=\"remote\", job=\"host\"} / windows_logical_disk_size_bytes{site=\"remote\", job=\"host\"})", "legendFormat": "{{volume_id}}" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } } },
    { "id": 10, "type": "stat", "title": "Last Boot", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "expr": "windows_system_boot_time_timestamp{site=\"remote\", job=\"host\"}", "legendFormat": "boot time" }], "fieldConfig": { "defaults": { "unit": "dateTimeAsIso", "decimals": 0 }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" } }
  ]
}
