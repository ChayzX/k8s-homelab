{
  "uid": "greenies-main-pc-health",
  "title": "Greenie's Main PC — Health",
  "description": "Windows/Docker gaming PC ('ThePantry'), monitored via windows_exporter and forwarded into this Prometheus through Grafana Alloy's remote-write receiver -- the same path used for Canada's host telemetry when that becomes available. No host selector is needed: every panel is scoped to the one remote Windows job. Labels verified live against Prometheus on 2026-09-21: site=\"windows-remote\", job=\"integrations/windows\", host=\"ThePantry\", instance=\"ThePantry\" -- this replaces the stale never-merged draft on feat/greenies-main-pc-dashboard, which assumed site=\"remote\"/job=\"host\" and never matched anything live.",
  "tags": ["homelab", "windows", "remote", "alloy", "pc", "gpu"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1 }
  ] },
  "panels": [
    { "type": "row", "title": "Current state", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    { "id": 1, "type": "stat", "title": "Host Reachable", "description": "Alloy remote-write scrape health for ThePantry. 0/no-data means Alloy on the Windows box has stopped forwarding metrics -- it does not by itself mean the PC is powered off.", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "up{site=\"windows-remote\", job=\"integrations/windows\"}", "legendFormat": "ThePantry" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN / NOT REPORTING", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }], "noValue": "NO DATA", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] } },
    { "id": 2, "type": "gauge", "title": "CPU Used", "description": "Whole-host CPU used, averaged across all logical cores from the idle-mode counter.", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "100 * (1 - avg(rate(windows_cpu_time_total{site=\"windows-remote\", mode=\"idle\"}[5m])))", "legendFormat": "CPU" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] } },
    { "id": 3, "type": "gauge", "title": "Memory Used", "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "100 * (1 - windows_memory_available_bytes{site=\"windows-remote\"} / windows_memory_physical_total_bytes{site=\"windows-remote\"})", "legendFormat": "memory" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }, "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 }] } }, "overrides": [] } },
    { "id": 4, "type": "stat", "title": "Uptime", "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "time() - windows_system_boot_time_timestamp{site=\"windows-remote\"}", "legendFormat": "uptime" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "colorMode": "value" }, "fieldConfig": { "defaults": { "unit": "dtdurations", "decimals": 1 }, "overrides": [] } },
    { "type": "row", "title": "CPU and memory", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }, "panels": [] },
    { "id": 5, "type": "timeseries", "title": "CPU by Mode", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "100 * avg by (mode) (rate(windows_cpu_time_total{site=\"windows-remote\"}[5m]))", "legendFormat": "{{mode}}" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 6, "type": "timeseries", "title": "Memory Available vs Total", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_memory_available_bytes{site=\"windows-remote\"}", "legendFormat": "available" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_memory_physical_total_bytes{site=\"windows-remote\"}", "legendFormat": "total" }], "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "type": "row", "title": "Disk and network", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "panels": [] },
    { "id": 7, "type": "timeseries", "title": "Disk Used % by Volume", "description": "Label is `volume` (e.g. C:, D:), not `volume_id` -- the draft on the stale branch used the wrong label name for this exporter version.", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "100 * (1 - windows_logical_disk_free_bytes{site=\"windows-remote\"} / windows_logical_disk_size_bytes{site=\"windows-remote\"})", "legendFormat": "{{volume}}" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } } },
    { "id": 8, "type": "timeseries", "title": "Network Throughput", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(windows_net_bytes_received_total{site=\"windows-remote\"}[5m])", "legendFormat": "{{nic}} received" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(windows_net_bytes_sent_total{site=\"windows-remote\"}[5m])", "legendFormat": "{{nic}} sent" }], "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "type": "row", "title": "Windows host details", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }, "panels": [] },
    { "id": 9, "type": "timeseries", "title": "Disk Free by Volume", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_logical_disk_free_bytes{site=\"windows-remote\"}", "legendFormat": "{{volume}}" }], "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" } } },
    { "id": 10, "type": "stat", "title": "Last Boot", "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_system_boot_time_timestamp{site=\"windows-remote\"}", "legendFormat": "boot time" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" }, "fieldConfig": { "defaults": { "unit": "dateTimeAsIso", "decimals": 0 }, "overrides": [] } },
    { "type": "row", "title": "GPU (NVIDIA GeForce RTX 3070)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "panels": [] },
    { "id": 11, "type": "table", "title": "GPU Adapter", "description": "Identity of the adapter windows_exporter is reporting on, from windows_gpu_info. An info-style metric: the value is always 1, the label set is the payload.", "gridPos": { "h": 5, "w": 24, "x": 0, "y": 33 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_gpu_info{site=\"windows-remote\"}", "format": "table", "instant": true }], "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true, "site": true }, "renameByName": { "name": "Adapter", "host": "Host", "device_id": "PCI Device ID", "bus_number": "Bus", "function_number": "Function", "luid": "LUID", "phys": "Physical Adapter Index" } } }], "options": { "showHeader": true, "cellHeight": "sm" }, "fieldConfig": { "defaults": {}, "overrides": [] } },
    { "id": 12, "type": "timeseries", "title": "GPU Engine Utilisation", "description": "windows_gpu_engine_time_seconds is a per-process, per-engine counter; rate() gives fractional engine-seconds/sec (i.e. percent busy) summed across every process, broken out by engine type (3D, Copy, VideoDecode, etc).", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (host, engtype) (rate(windows_gpu_engine_time_seconds{site=\"windows-remote\"}[5m])) * 100", "legendFormat": "{{host}} {{engtype}}" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 13, "type": "timeseries", "title": "GPU Adapter Memory", "description": "Dedicated (on-board VRAM), shared (system RAM borrowed by the GPU), and committed (total the adapter has reserved) memory for the whole adapter.", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_gpu_adapter_memory_dedicated_bytes{site=\"windows-remote\"}", "legendFormat": "dedicated" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_gpu_adapter_memory_shared_bytes{site=\"windows-remote\"}", "legendFormat": "shared" }, { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "windows_gpu_adapter_memory_committed_bytes{site=\"windows-remote\"}", "legendFormat": "committed" }], "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } } },
    { "id": 14, "type": "timeseries", "title": "Top GPU Memory Consumers (dedicated, by process)", "description": "windows_exporter only labels this by process_id, not process name (no name label is exposed) -- cross-reference the PID with Task Manager on the box if you need to know which application this is. topk(8) keeps the panel readable when many processes touch the GPU.", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "topk(8, windows_gpu_process_memory_dedicated_bytes{site=\"windows-remote\"})", "legendFormat": "pid {{process_id}}" }], "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } } }
  ]
}
