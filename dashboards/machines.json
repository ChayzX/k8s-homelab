   "options": {
    "mode": "markdown",
    "content": "## How is one machine doing?\nPick a **Machine** at the top. Big dials: green is fine, orange is getting tight, red needs attention."
   }
  },
  {
   "type": "gauge",
   "title": "CPU busy",
   "description": "Sustained above 90% makes everything slow.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"$machine\", mode=\"idle\"}[5m])))",
     "legendFormat": "CPU %",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - avg(rate(windows_cpu_time_total{instance=\"$machine\", mode=\"idle\"}[5m])))",
     "legendFormat": "CPU %",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true,
    "showThresholdLabels": false
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 3
   }
  },
  {
   "type": "gauge",
   "title": "Memory used",
   "description": "Above ~90% the system starts killing programs to free memory.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"$machine\"} / node_memory_MemTotal_bytes{instance=\"$machine\"})",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - windows_memory_available_bytes{instance=\"$machine\"} / windows_memory_physical_total_bytes{instance=\"$machine\"})",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true,
    "showThresholdLabels": false
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 92
       }
      ]
