    "x": 6,
    "y": 3
   }
  },
  {
   "type": "gauge",
   "title": "Fullest disk",
   "description": "The fullest drive on this machine. At 100% things stop working.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(100 * (1 - node_filesystem_avail_bytes{instance=\"$machine\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{instance=\"$machine\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"}))",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max(100 * (1 - windows_logical_disk_free_bytes{instance=\"$machine\"} / windows_logical_disk_size_bytes{instance=\"$machine\"}))",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showThresholdMarkers": true,
    "showThresholdLabels": false
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 12,
    "y": 3
   }
