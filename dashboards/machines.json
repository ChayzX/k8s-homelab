  {
   "type": "stat",
   "title": "Up for",
   "description": "Time since the last reboot. A surprisingly small number means it restarted on its own.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "time() - node_boot_time_seconds{instance=\"$machine\"}",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "time() - windows_system_boot_time_timestamp{instance=\"$machine\"}",
     "instant": true,
     "range": false
