    {
      "id": 6,
      "type": "table",
      "title": "Every service and its site",
      "description": "Workloads from kube-state-metrics, stamped site=\"home\" because they are objects of the home cluster. Remote sites appear here only once they are scraped into this Prometheus.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(sum by (namespace, deployment) (kube_deployment_status_replicas_available), \"site\", \"home\", \"\", \"\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "label_replace(sum by (namespace, deployment) (kube_deployment_spec_replicas), \"site\", \"home\", \"\", \"\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "deployment",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "namespace 2": true,
              "site 2": true
            },
            "renameByName": {
              "site 1": "Site",
              "site": "Site",
              "namespace 1": "Namespace",
              "namespace": "Namespace",
              "deployment": "Service",
              "Value #A": "Ready",
              "Value #B": "Desired"
            },
            "indexByName": {
              "site 1": 0,
              "namespace 1": 1,
              "deployment": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Site"
              },
              {
                "field": "Namespace"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Site"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
