    {
      "id": 11,
      "type": "stat",
      "title": "PantryBot Containers CrashLooping (home)",
      "description": "Non-zero means the home app plane is failing, not parked. A parked plane has its Deployments scaled to 0 and shows nothing here.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"pantry-bot\", reason=\"CrashLoopBackOff\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
