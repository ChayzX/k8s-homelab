  {
   "id": 17,
   "type": "stat",
   "title": "Serving site",
   "description": "Which site PantryBot is running from right now (the site whose API answers). Home is the normal site; Oracle and Canada take over automatically during a failover (#191).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (site) (up{job=~\"pantry-bot-api(-oracle|-canada)?\"}) == 1",
     "legendFormat": "{{site}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "NONE - PantryBot is down",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Every PantryBot part",
   "description": "Parts deliberately switched off (0 copies) are not listed.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (deployment) (kube_deployment_spec_replicas{namespace=\"pantry-bot\"}) > 0",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"pantry-bot\"}) and on (deployment) (kube_deployment_spec_replicas{namespace=\"pantry-bot\"} > 0)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "uid": true,
       "endpoint": true,
       "service": true
      },
      "renameByName": {
       "deployment": "Part",
       "Value #A": "Should have",
       "Value #B": "Running"
      },
      "indexByName": {
       "deployment": 0,
       "Value #A": 1,
       "Value #B": 2
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
