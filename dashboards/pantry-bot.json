 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "## PantryBot on Oracle\nThis page checks live application scrape targets, PostgreSQL reachability, and logs. Chat command and feature usage is on **PantryBot Chat Usage**. A missing scrape target means telemetry is unavailable; it does not mean that feature was unused."
   }
  },
  {
   "type": "stat",
   "title": "Parts running",
   "description": "Oracle API, gateway, dispatcher, and each worker pod scraped successfully.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "count(up{job=~\"pantry-bot-(api|gateway|worker|dispatcher)-oracle\"} == 1)",
     "legendFormat": "targets up",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "count(up{job=~\"pantry-bot-(api|gateway|worker|dispatcher)-oracle\"})",
     "legendFormat": "targets discovered",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Scrape targets down",
   "description": "A failed target means Prometheus cannot collect its telemetry. This is not a Kubernetes restart count.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(1 - up{job=~\"pantry-bot-(api|gateway|worker|dispatcher)-oracle\"})",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NONE",
         "color": "green",
         "index": 0
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Database reachable?",
   "description": "A fresh read-only connection from Grafana to the Oracle PantryBot database.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "${DS_POSTGRES}"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT 1 AS reachable"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NO",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "YES",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Runtime work completed (24h)",
   "description": "Completed durable runtime jobs. Kubernetes restart counts are not available from this Prometheus datasource.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(pantry_bot_runtime_completions_total[24h])) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 3
   }
  },
  {
   "type": "table",
   "title": "Oracle scrape targets",
   "description": "One row per scraped target, including each worker pod. 1 means telemetry is arriving; 0 or a missing row means telemetry is unavailable.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "up{job=~\"pantry-bot-(api|gateway|worker|dispatcher)-oracle\"}",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "uid": true,
       "endpoint": true,
       "service": true
      },
      "renameByName": {
       "role": "Role",
       "site": "Site",
       "pod": "Pod",
       "Value": "Scrape up"
      },
      "indexByName": {
       "role": 0,
       "site": 1,
       "pod": 2,
       "Value": 3
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "noValue": "Nothing here — good."
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Scrape up"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "id": 6,
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 8
   }
  },
  {
   "type": "row",
   "title": "What is it saying?  (logs)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 16
   },
   "panels": [],
   "id": 7
  },
  {
   "type": "logs",
   "title": "PantryBot errors and warnings",
   "description": "Only errors and warnings, newest first.",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "{instance=~\"pantry-bot/.*\", level=~\"error|warn\"}",
     "maxLines": 500
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "exact",
    "prettifyLogMessage": false,
    "showLabels": false,
    "showCommonLabels": false
   },
   "id": 8,
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
