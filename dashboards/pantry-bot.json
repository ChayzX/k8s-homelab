  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "## PantryBot\nTop half: **is it working?** Bottom half: **is anyone using it?** If the top is red, the bottom will be empty — fix the top first. For one part in detail, open Services and pick Area `pantry-bot`."
   }
  },
  {
   "type": "stat",
   "title": "Parts running",
   "description": "PantryBot roles (api, gateway, worker, dispatcher) answering at whichever site is serving - Home, Oracle or Canada - vs the 4 there should be. Follows failovers (#191).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "count(up{job=~\"pantry-bot-(api|gateway|worker|dispatcher)(-oracle|-canada)?\"} == 1) or vector(0)",
     "legendFormat": "running",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "vector(4)",
     "legendFormat": "should be",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 5,
    "x": 0,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Parts crashing",
   "description": "Parts stuck in a crash-restart loop.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"pantry-bot\", reason=\"CrashLoopBackOff\"}) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NONE",
         "color": "green",
         "index": 0
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
