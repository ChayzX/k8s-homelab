 "templating": {
  "list": [
   {
    "name": "DS_PROMETHEUS",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 2,
    "refresh": 1,
    "regex": ""
   },
   {
    "name": "DS_LOKI",
    "label": "Loki",
    "type": "datasource",
    "query": "loki",
    "current": {},
    "hide": 2,
    "refresh": 1,
    "regex": ""
   },
   {
    "name": "namespace",
    "label": "Area",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "definition": "label_values(kube_deployment_spec_replicas, namespace)",
    "query": {
     "query": "label_values(kube_deployment_spec_replicas, namespace)",
     "refId": "ns"
    },
    "refresh": 1,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "hide": 0,
    "current": {
     "text": "pantry-bot",
     "value": "pantry-bot"
    },
    "regex": ""
   },
   {
    "name": "workload",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "definition": "query_result(label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"deployment\", \"(.*)\") or label_replace(kube_statefulset_replicas{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"statefulset\", \"(.*)\") or label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"daemonset\", \"(.*)\"))",
    "query": {
     "query": "query_result(label_replace(kube_deployment_spec_replicas{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"deployment\", \"(.*)\") or label_replace(kube_statefulset_replicas{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"statefulset\", \"(.*)\") or label_replace(kube_daemonset_status_desired_number_scheduled{namespace=\"$namespace\"} > 0, \"workload\", \"$1\", \"daemonset\", \"(.*)\"))",
     "refId": "wl"
    },
    "regex": "/workload=\"([^\"]+)\"/",
    "refresh": 2,
    "sort": 1,
    "includeAll": false,
    "multi": false,
    "hide": 0,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "## How is one service doing?\nPick an **Area** and a **Service** at the top. Everything below is about just that service. Red boxes mean trouble; the logs at the bottom usually say why."
   }
  },
  {
   "type": "stat",
   "title": "Is it running?",
   "description": "How many copies are running right now.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(kube_pod_status_phase{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\", phase=\"Running\"}) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NOT RUNNING",
         "color": "red",
         "index": 0
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 2,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Ready to serve?",
   "description": "Running is not the same as working. Ready means it passed its own health check and is accepting work.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "min(kube_pod_container_status_ready{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"}) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NOT READY",
         "color": "red",
         "index": 0
        },
        "1": {
         "text": "READY",
         "color": "green",
         "index": 1
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Restarts today",
   "description": "0 is normal. A few can be a one-off. Dozens means it is crash-looping.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"}[24h])) or vector(0)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "NONE",
         "color": "green",
         "index": 0
        }
       }
      }
     ],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 4,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 12,
    "y": 3
   }
  },
  {
   "type": "stat",
   "title": "Why it last stopped",
   "description": "OOMKilled = ran out of memory. Error = the app exited with a fault. Completed = a normal stop. \"no data\" = it has never stopped.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "max by (reason) (kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"})",
     "legendFormat": "{{reason}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "name",
    "justifyMode": "center",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "noValue": "no data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 5,
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 3
   }
  },
  {
   "type": "row",
   "title": "Is it short of resources?",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "panels": [],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Memory — used vs its limit",
   "description": "If \"used\" reaches \"limit\", Kubernetes kills the app (OOMKilled). No limit line means none is set.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\", container!=\"\"})",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\", resource=\"memory\"})",
     "legendFormat": "limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "nothing to show",
     "min": 0
    },
    "overrides": []
   },
   "id": 7,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   }
  },
  {
   "type": "timeseries",
   "title": "CPU — used vs its limit (cores)",
   "description": "Hitting the limit does not crash the app, it just makes it slow.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\", container!=\"\"}[5m]))",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\", resource=\"cpu\"})",
     "legendFormat": "limit"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "nothing to show",
     "min": 0
    },
    "overrides": []
   },
   "id": 8,
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   }
  },
  {
   "type": "timeseries",
   "title": "Network traffic",
   "description": "Flat at zero for a service that should be busy is suspicious.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"}[5m]))",
     "legendFormat": "in"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"}[5m]))",
     "legendFormat": "out"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "nothing to show",
     "min": 0
    },
    "overrides": []
   },
   "id": 9,
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 17
   }
  },
  {
   "type": "timeseries",
   "title": "Restarts over time",
   "description": "When the restarts started is often the best clue to what changed.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"${workload}-([a-z0-9]+-)?[a-z0-9]+\"}[1h]))",
     "legendFormat": "restarts / hour"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity"
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "nothing to show",
     "min": 0
    },
    "overrides": []
   },
   "id": 10,
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 17
   }
  },
  {
   "type": "row",
   "title": "What is it saying?  (logs)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 24
   },
   "panels": [],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Log lines by severity",
   "description": "Red is errors. A burst of red right before a restart points at the cause.",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "sum by (level) (count_over_time({instance=~\"$namespace/${workload}-.*\"} [$__auto]))",
     "legendFormat": "{{level}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true,
      "gradientMode": "opacity",
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "noValue": "nothing to show"
    },
    "overrides": []
   },
   "id": 12,
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 25
   }
  },
  {
   "type": "logs",
   "title": "Latest log lines",
   "description": "Newest first. Look for the lines just before the app stopped.",
   "datasource": {
    "type": "loki",
    "uid": "${DS_LOKI}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "${DS_LOKI}"
     },
     "expr": "{instance=~\"$namespace/${workload}-.*\"}",
     "maxLines": 500
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "exact",
    "prettifyLogMessage": false,
    "showLabels": false,
    "showCommonLabels": false
   },
   "id": 13,
   "gridPos": {
    "h": 14,
    "w": 24,
    "x": 0,
    "y": 31
   }
  }
 ]
}
