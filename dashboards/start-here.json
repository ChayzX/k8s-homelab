  {
   "type": "gauge",
   "title": "Main disk full",
   "description": "When this reaches 100% most things stop working. Clean up above 85%.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"192.168.40.208:9100\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{instance=\"192.168.40.208:9100\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs\"})",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
