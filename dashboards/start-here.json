  {
   "type": "table",
   "title": "Apps crashing over and over",
   "description": "Open Services, pick this app, and read its logs at the bottom — the reason for the crash is almost always the last few lines before each restart.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"} == 1",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "kube_pod_container_status_restarts_total and on (namespace, pod, container) (kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"} == 1)",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "uid": true,
       "endpoint": true,
       "service": true,
       "reason": true,
       "Value #A": true
      },
      "renameByName": {
       "namespace": "Area",
       "pod": "App (pod)",
       "container": "Part",
       "Value #B": "Times restarted"
      },
      "indexByName": {
       "namespace": 0,
       "pod": 1,
       "container": 2,
       "Value #B": 3
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Times restarted"
       }
      ]
     }
    }
