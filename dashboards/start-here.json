  {
   "type": "stat",
   "title": "Overall",
   "description": "How many things need attention right now, added up from the three boxes to the right.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "(sum(kube_pod_container_status_waiting_reason{reason=\"CrashLoopBackOff\"}) or vector(0)) + (sum(kube_deployment_status_replicas_unavailable) or vector(0)) + (count(kube_node_status_condition{condition=\"Ready\", status=\"true\"} == 0) or vector(0))",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
