   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"192.168.40.208:9100\"} / node_memory_MemTotal_bytes{instance=\"192.168.40.208:9100\"})",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
