{
  "uid": "homelab-apps",
  "title": "Apps — Minecraft / jmusicbot / pantry-bot",
  "description": "App-specific panels for the three bespoke workloads. Only Minecraft has a real application-level exporter (RCON-based); jmusicbot and pantry-bot have no scraped app metrics, so their sections are honestly limited to Kubernetes-visible signals (pod status, restarts, memory vs limit, readiness). See individual panel descriptions for exactly what each metric does and does not tell you.",
  "tags": ["homelab", "k3s", "apps"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Minecraft — RCON-based exporter (TPS, players, world size); memory via cAdvisor, not psutil",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Server Up",
      "description": "minecraft_server_up, from minecraft_exporter's RCON poll (in-cluster now, via the minecraft-rcon ClusterIP Service). 1 = RCON connected successfully.",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_server_up", "legendFormat": "up" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Players Online / Max",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_online", "legendFormat": "online" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_max", "legendFormat": "max" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "TPS (1m)",
      "description": "20.0 is perfect. Below 15 is visibly laggy (mob AI, redstone, block breaking slow down); below 10 is severe. Heap is capped at -Xmx6G (down from 12G) as of this migration -- if TPS regresses versus the old Docker deployment, check the JVM Memory panel below before assuming it's unrelated.",
      "gridPos": { "h": 4, "w": 6, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_1m", "legendFormat": "tps" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "#EAB839", "value": 15 }, { "color": "green", "value": 19 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Pod Memory vs 8Gi Limit",
      "description": "container_memory_working_set_bytes for the minecraft container, from kubelet's cAdvisor endpoint -- NOT the old minecraft_process_memory_bytes gauge. That gauge is gone: it came from psutil reading the java process's RSS from outside the container's PID namespace, which does not work once the process is containerized. This is the cgroup working-set number, which is what the OOM killer actually compares against the 8Gi limit. Heap is -Xmx6G, so 2Gi of headroom above the heap ceiling is expected for JVM overhead (metaspace, off-heap, native buffers) -- watch this trend after a few days of real play per the migration plan's verification step.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"})"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "max": 8589934592,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 6442450944 },
              { "color": "red", "value": 7301444813 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TPS Over Time (1m / 5m / 15m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_1m", "legendFormat": "1m" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_5m", "legendFormat": "5m" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_15m", "legendFormat": "15m" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pod Memory vs Limit Over Time",
      "description": "Solid = working set (cAdvisor). Dashed = 8Gi limit. Dotted = 3Gi request. A second dashed reference at 6Gi marks the -Xmx heap ceiling, so you can see how much of the gap above it is JVM overhead vs actual growth.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"})",
          "legendFormat": "working set"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"memory\"})",
          "legendFormat": "LIMIT (8Gi)"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"memory\"})",
          "legendFormat": "request (3Gi)"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vector(6442450944)",
          "legendFormat": "-Xmx6G heap ceiling"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "LIMIT (8Gi)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [12, 6] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "request (3Gi)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [2, 6] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "-Xmx6G heap ceiling" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Players Online Over Time",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_online", "legendFormat": "players" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 40, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU Usage vs Limit (cores)",
      "description": "Request 2 cores, limit 6 cores. cAdvisor rate of container_cpu_usage_seconds_total.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"}[5m]))",
          "legendFormat": "usage"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"cpu\"})",
          "legendFormat": "LIMIT (6 cores)"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisLabel": "cores" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "LIMIT (6 cores)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [12, 6] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "World Size on Disk",
      "description": "minecraft_world_size_bytes, checked every 10 minutes (not continuously -- walking thousands of small region files on every 15s poll would be wasteful and would itself add HDD load). A sudden jump can indicate world corruption/duplication, not just normal exploration growth.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_world_size_bytes", "legendFormat": "{{world}}" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pod Restarts (24h)",
      "description": "There is deliberately NO livenessProbe on the minecraft container -- a wedged JVM restarting mid-tick would risk world corruption, which is a worse outcome than a hung server. So this number will not self-heal a hang; readinessProbe alone drives traffic/RCON gating. A restart here means either an OOMKill (see cluster/pods dashboards) or the container process actually exiting.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"minecraft\"}[24h])) or vector(0)", "legendFormat": "restarts" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 1 }, { "color": "red", "value": 2 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Minecraft Server Logs",
      "description": "Paper/Log4j format, level extracted by promtail. Use the Logs dashboard for full severity-filter/search controls -- this is a fixed quick view scoped to this pod.",
      "gridPos": { "h": 10, "w": 24, "x": 6, "y": 20 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{namespace=\"minecraft\"}", "maxLines": 1000 }],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "row",
      "title": "jmusicbot — no application metrics exist; pod-level signals only",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "panels": []
    },
    {
      "id": 12,
      "type": "text",
      "title": "About this section",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 31 },
      "options": {
        "mode": "markdown",
        "content": "jmusicbot is a Discord bot with **no Prometheus exporter or metrics endpoint** -- it never had one on Docker either. There is no TODO to \"add\" a real metric here; the honest state is that the only signal available is what Kubernetes itself observes about the pod (running/not, restarts, memory). `release-notifier` (GitHub release poller, posts to Discord) is included below since it shares the namespace."
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Pod Status (jmusicbot namespace)",
      "gridPos": { "h": 7, "w": 10, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "kube_pod_status_phase{namespace=\"jmusicbot\"} == 1", "format": "table", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"jmusicbot\"})", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "pod", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "__name__": true, "job": true, "instance": true, "namespace": true, "uid": true, "Value #A": true },
            "renameByName": { "pod": "Pod", "phase": "Phase", "Value #B": "Restarts" },
            "indexByName": {}
          }
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Phase" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Running": { "color": "green", "index": 0 } } },
                  { "type": "value", "options": { "Pending": { "color": "orange", "index": 1 } } },
                  { "type": "value", "options": { "Failed": { "color": "red", "index": 2 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Restarts" },
            "properties": [
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 1 }, { "color": "red", "value": 5 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory vs Limit — jmusicbot (1Gi) / release-notifier (128Mi)",
      "gridPos": { "h": 7, "w": 14, "x": 10, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"jmusicbot\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{container}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"jmusicbot\", resource=\"memory\"})",
          "legendFormat": "{{container}} LIMIT"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*LIMIT$" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [12, 6] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "jmusicbot Restarts (rolling 1h)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"jmusicbot\"}[1h]))", "legendFormat": "{{container}}" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "jmusicbot Logs",
      "description": "Java/Log4j format. Watch here for the exact YouTube itag-18 decode failure this deployment is a workaround for (see the deployment manifest's CUSTOM-BUILD-NOTE) -- 'Something went wrong when decoding the track' is the signature string.",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{namespace=\"jmusicbot\"}", "maxLines": 1000 }],
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
