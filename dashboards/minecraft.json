{
  "uid": "homelab-minecraft",
  "title": "Minecraft — Server Health & Performance",
  "description": "Minecraft server health, performance, resource use, and logs. Application metrics are from the in-cluster RCON exporter; resource metrics are Kubernetes/cAdvisor signals.",
  "tags": ["homelab", "k3s", "minecraft"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1, "regex": "", "skipUrlSync": false },
    { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "query": "loki", "current": {}, "hide": 0, "refresh": 1, "regex": "", "skipUrlSync": false }
  ] },
  "panels": [
    { "type": "row", "title": "Server health — RCON exporter", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    { "id": 1, "type": "stat", "title": "Server Up", "description": "minecraft_server_up is produced by the RCON exporter. 1 means the exporter connected to the server successfully.", "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_server_up", "legendFormat": "up" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] } },
    { "id": 2, "type": "stat", "title": "Players Online / Max", "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_online", "legendFormat": "online" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_max", "legendFormat": "max" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "horizontal", "textMode": "value_and_name", "colorMode": "none", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] } },
    { "id": 3, "type": "gauge", "title": "TPS (1m)", "description": "20.0 is perfect; below 15 is visibly laggy and below 10 is severe.", "gridPos": { "h": 4, "w": 6, "x": 10, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_1m", "legendFormat": "tps" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }, "fieldConfig": { "defaults": { "min": 0, "max": 20, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "#EAB839", "value": 15 }, { "color": "green", "value": 19 }] } }, "overrides": [] } },
    { "id": 4, "type": "gauge", "title": "Pod Memory vs 8Gi Limit", "description": "Working set from cAdvisor. This is the cgroup value the OOM killer compares with the container limit; it intentionally replaces the retired host-process psutil metric.", "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"})" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }, "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "max": 8589934592, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 6442450944 }, { "color": "red", "value": 7301444813 }] } }, "overrides": [] } },
    { "id": 5, "type": "timeseries", "title": "TPS Over Time (1m / 5m / 15m)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_1m", "legendFormat": "1m" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_5m", "legendFormat": "5m" }, { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_tps_15m", "legendFormat": "15m" }], "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "min": 0, "max": 20, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] } },
    { "id": 6, "type": "timeseries", "title": "Pod Memory vs Limit Over Time", "description": "Solid working set, dashed 8Gi limit, dotted 3Gi request, and 6Gi JVM heap ceiling reference.", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(container_memory_working_set_bytes{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"})", "legendFormat": "working set" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_limits{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"memory\"})", "legendFormat": "LIMIT (8Gi)" }, { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_requests{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"memory\"})", "legendFormat": "request (3Gi)" }, { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "vector(6442450944)", "legendFormat": "-Xmx6G heap ceiling" }], "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] } },
    { "id": 7, "type": "timeseries", "title": "Players Online Over Time", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_players_online", "legendFormat": "players" }], "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } }, "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" }, "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 40, "showPoints": "never", "spanNulls": false } }, "overrides": [] } },
    { "id": 8, "type": "timeseries", "title": "CPU Usage vs Limit (cores)", "description": "cAdvisor CPU usage; request is 2 cores and limit is 6 cores.", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\"}[5m]))", "legendFormat": "usage" }, { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kube_pod_container_resource_limits{namespace=\"minecraft\", pod=~\"minecraft-.*\", container=\"minecraft\", resource=\"cpu\"})", "legendFormat": "LIMIT (6 cores)" }], "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "none", "min": 0, "decimals": 2, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisLabel": "cores" } }, "overrides": [] } },
    { "id": 9, "type": "timeseries", "title": "World Size on Disk", "description": "minecraft_world_size_bytes is intentionally collected every ten minutes to avoid adding HDD load by walking region files on every scrape.", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "minecraft_world_size_bytes", "legendFormat": "{{world}}" }], "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } }, "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false } }, "overrides": [] } },
    { "type": "row", "title": "Kubernetes lifecycle and logs", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "panels": [] },
    { "id": 10, "type": "stat", "title": "Pod Restarts (24h)", "description": "Minecraft intentionally has no liveness probe because restarting a wedged JVM mid-tick risks world corruption. A restart means an actual process exit or OOMKill.", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 21 }, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"minecraft\"}[24h])) or vector(0)", "legendFormat": "restarts" }], "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" }, "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 1 }, { "color": "red", "value": 2 }] } }, "overrides": [] } },
    { "id": 11, "type": "logs", "title": "Minecraft Server Logs", "description": "Paper/Log4j logs with severity extracted by Alloy. Use the Logs dashboard for full cross-workload filtering.", "gridPos": { "h": 10, "w": 18, "x": 6, "y": 21 }, "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "targets": [{ "refId": "A", "datasource": { "type": "loki", "uid": "${DS_LOKI}" }, "expr": "{namespace=\"minecraft\"}", "maxLines": 1000 }], "options": { "showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" }, "fieldConfig": { "defaults": {}, "overrides": [] } }
  ]
}
