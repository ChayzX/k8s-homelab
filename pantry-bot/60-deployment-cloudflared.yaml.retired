# RETIRED — preserved for rollback reference; do not apply.
# =============================================================================
# cloudflared — Cloudflare Tunnel connector for pantry-bot
# =============================================================================
# Replaces the `cloudflared` service in
# /home/chase/Downloads/pantry-bot/docker-compose.prod.yml
#
# Stateless. No PVC, no ports published to the node. It makes only OUTBOUND
# connections to Cloudflare's edge and forwards inbound tunnel traffic to
# pantry-bot's ClusterIP Service.
#
# -----------------------------------------------------------------------------
# TWO CHANGES FROM THE COMPOSE VERSION, BOTH DELIBERATE
# -----------------------------------------------------------------------------
# 1. The token moves out of the command line.
#    Compose ran: `tunnel --no-autoupdate run --token ${CLOUDFLARE_TUNNEL_TOKEN}`
#    which puts the credential in argv, where it is visible to anything that can
#    read the process table, and in `kubectl describe pod` output. cloudflared
#    reads the same value from the TUNNEL_TOKEN environment variable when `run`
#    is given no token argument, so the token comes from a Secret instead. This
#    is the documented, supported form — not a workaround.
#
# 2. `--metrics 0.0.0.0:2000` is added so there is something real to probe.
#    cloudflared serves /ready on its metrics listener, which reports whether
#    the connector actually has registered tunnel connections to Cloudflare's
#    edge. Without it the only available signal is "the process has not
#    exited", which stays true while the tunnel is completely down. Drop the
#    flag and both probes together if you want the command byte-identical to
#    the Compose one.
#
# Ordering: Compose used `depends_on: bot`. Kubernetes has no equivalent and
# does not need one — cloudflared retries its origin connection, and the
# Service resolves whether or not a pantry-bot pod is Ready yet.
#
# 3. TUNNEL_TRANSPORT_PROTOCOL=http2, added after diagnosing intermittent
#    "application not found" on the Authentik-fronted apps (auth/grafana/
#    status/operations, all served through this same tunnel). Live logs
#    showed cloudflared repeatedly cycling all 4 QUIC connections with
#    `failed to accept QUIC stream: timeout: no recent network activity`
#    (157 occurrences in one 1000-line log window) — a known failure mode
#    where a router/firewall's UDP idle timeout drops the QUIC session
#    under Cloudflare's default transport. http2 runs over a persistent TCP
#    connection instead, which is far more tolerant of typical home-router
#    UDP handling. See ChayzX/k8s-homelab#72 and ChayzX/Operations-ios-app#61.
# =============================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: pantry-bot
  labels:
    app.kubernetes.io/name: cloudflared
    app.kubernetes.io/part-of: homelab
    app.kubernetes.io/component: tunnel
  # No keel.sh annotations. The connector release is pinned below so an
  # upstream tag move cannot silently change the public failover path.
spec:
  # 2, not 1: as of the Oracle node joining as a second k3s agent
  # (pantry-bot-infra), one replica per node via the anti-affinity rule
  # below gives HTTP-surface redundancy for free — Cloudflare's edge already
  # knows how to route to whichever connector of a tunnel is alive, no
  # coordination needed on this side. Until the Oracle node actually exists
  # and is Ready, the second replica sits Pending — expected, not a bug.
  replicas: 2
  # maxSurge: 0 / maxUnavailable: 1, NOT the more common maxSurge: 1 /
  # maxUnavailable: 0 -- deliberately, after hitting a real deadlock with the
  # latter. The one-per-node anti-affinity rule below caps this cluster at 2
  # scheduled cloudflared pods total (2 nodes), but maxSurge: 1 wants a 3rd
  # pod to exist briefly during every rollout before removing the old one.
  # With exactly 2 nodes and 2 replicas, that 3rd pod can never schedule --
  # it sits Pending forever, and the old pod it was supposed to replace never
  # gets removed either, since maxUnavailable: 0 refuses to remove it until
  # the new one is Ready. Observed directly on the first real rollout after
  # the Oracle node joined. maxSurge: 0 avoids the deadlock structurally: it
  # never asks for more than 2 pods at once, which always fits.
  #
  # Trade-off knowingly accepted: a rollout now removes the old pod on a node
  # before the new one is Ready there, so that node briefly has zero
  # cloudflared coverage (a few seconds) instead of a clean handover. With 2
  # replicas across 2 nodes, the *other* node's connector stays up throughout,
  # so the tunnel as a whole never fully drops -- this is a gap in per-node
  # coverage, not in overall availability.
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cloudflared
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cloudflared
        app.kubernetes.io/part-of: homelab
        app.kubernetes.io/component: tunnel
    spec:
      serviceAccountName: cloudflared-sa
      # One replica per node, not two on the same node — the whole point is
      # surviving a single node going down.
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/name: cloudflared
              topologyKey: kubernetes.io/hostname
      # Zero Kubernetes API access required.
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        # UID 65532 = the `nonroot` user in the distroless-style cloudflared
        # image. Verified against the running container
        # (`docker top pantry-bot-cloudflared-1 -o user,group`).
        runAsUser: 65532
        runAsGroup: 65532
        runAsNonRoot: true
      containers:
        - name: cloudflared
          # Verified multi-architecture manifest digest (amd64 + arm64).
          image: cloudflare/cloudflared:2026.7.3@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf
          imagePullPolicy: IfNotPresent
          args:
            - tunnel
            - --no-autoupdate
            - --metrics
            - 0.0.0.0:2000
            - run
          env:
            # The tunnel token encodes the tunnel ID and its credentials, and
            # for a remotely-managed tunnel it is also how cloudflared fetches
            # its ingress configuration from Cloudflare. Anyone holding it can
            # run this tunnel. See SECRETS.md.
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflared-tunnel
                  key: TUNNEL_TOKEN
            # See change 3 in the header comment: forces TCP-based HTTP/2
            # transport instead of the QUIC/UDP default.
            - name: TUNNEL_TRANSPORT_PROTOCOL
              value: http2
          ports:
            - name: metrics
              containerPort: 2000
              protocol: TCP
          readinessProbe:
            # /ready returns 200 only while the connector has at least one
            # registered connection to the Cloudflare edge — a genuine health
            # signal, unlike "process is running".
            httpGet:
              path: /ready
              port: metrics
            initialDelaySeconds: 10
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /ready
              port: metrics
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            # Generous: a transient Cloudflare edge blip should not restart the
            # connector, which reconnects on its own. 5 x 30s = 2.5 minutes of
            # sustained disconnection before a restart.
            failureThreshold: 5
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            # readOnlyRootFilesystem is left off deliberately. cloudflared may
            # write to /tmp and to a per-user config dir depending on version
            # and flags, and a rootfs failure here takes down the only publicly
            # reachable path into this cluster. If you want it, add:
            #   readOnlyRootFilesystem: true
            # together with an emptyDir mounted at /tmp AND at /home/nonroot,
            # and verify the tunnel actually registers afterwards — the failure
            # is a silent non-registration, not a crash.
