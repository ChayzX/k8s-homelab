[Service]
ExecStart=
ExecStart=/usr/bin/python3 /usr/local/lib/failover-witness/oracle_promoter.py --pod-namespace pantry-bot --service-namespace pantry-bot --pod postgres-authority-standby-reseed-0 --service postgres-authority-standby-reseed --postgres-port 5432 --data-directory /var/lib/postgresql/data/pgdata --manual-endpoint
