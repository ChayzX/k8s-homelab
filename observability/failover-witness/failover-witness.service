[Unit]
Description=Homelab fenced failover witness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=failover-witness
Group=failover-witness
EnvironmentFile=/etc/failover-witness/witness.env
ExecStart=/usr/bin/python3 /usr/local/lib/failover-witness/witness.py --listen 127.0.0.1 --port 8765 --state /var/lib/failover-witness/state.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=failover-witness
ReadWritePaths=/var/lib/failover-witness

[Install]
WantedBy=multi-user.target
