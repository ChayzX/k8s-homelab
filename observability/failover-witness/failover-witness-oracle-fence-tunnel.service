[Unit]
Description=Reverse SSH Oracle PostgreSQL fence path to GCP witness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -i /home/ubuntu/.ssh/gcp-witness-oracle -R 127.0.0.1:18767:127.0.0.1:22 sa_105559435168833655240@136.113.178.106
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
