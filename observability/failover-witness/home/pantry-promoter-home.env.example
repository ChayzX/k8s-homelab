# /etc/failover-witness/pantry-promoter-home.env (root 600). #191
# WITNESS_SHARED_SECRET is installed separately and never committed.
WITNESS_URL=http://127.0.0.1:18765
WITNESS_SHARED_SECRET=<installed-on-host>
PANTRY_PROMOTION_SITE_NAME=home
LOCAL_WRITER_FENCE_COMMAND="/usr/local/lib/failover-witness/fence-home-postgres-local.sh --confirm"
OLD_WRITER_FENCE_COMMAND="/usr/local/lib/failover-witness/fence-old-writers-from-home.sh --confirm"
REPLICATION_CHECK_COMMAND=/usr/local/lib/failover-witness/oracle-replication-check.sh
SERVICE_CHECK_COMMAND=/usr/local/lib/failover-witness/oracle-service-check.sh
PUBLISH_ROUTES_COMMAND=/usr/local/lib/failover-witness/publish-cloudflare-routes.sh
# Remote fences
ORACLE_FENCER_KUBECONFIG=/etc/failover-witness/pantry-postgres-fencer-oracle.kubeconfig
CANADA_ADDRESS=100.104.83.28
CANADA_ADMIN_KEY=/etc/failover-witness/canada-fence
CANADA_FENCE_SCRIPT=C:\\ProgramData\\PantryBotCanadaPrep\\fence-canada-writer.ps1
# Replication / service checks
PANTRY_NAMESPACE=pantry-bot
PANTRY_STANDBY_POD=postgres-authority-standby-home-canada-0
PANTRY_POSTGRES_CONTAINER=postgres
PANTRY_POSTGRES_USER=pantry
PANTRY_POSTGRES_DB=pantry
PANTRY_POSTGRES_PORT=5432
PANTRY_ORACLE_POD=postgres-authority-standby-home-canada-0
PANTRY_ORACLE_SERVICE=postgres-authority-standby-home-canada
