[Unit]
Description=Authentik Oracle PostgreSQL promotion controller (guarded)
Wants=network-online.target
After=network-online.target k3s.service failover-witness-oracle-tunnel.service

[Service]
Type=simple
# Install a root-owned EnvironmentFile with WITNESS_URL and
# WITNESS_SHARED_SECRET. The old-writer command must be independently
# reachable and must fail unless the home writer is actually fenced.
ExecStart=/usr/bin/python3 /usr/local/lib/failover-witness/authentik_oracle_promoter.py \
  --fence-command "/usr/local/lib/failover-witness/fence-authentik-postgres-oracle.sh --confirm" \
  --old-writer-fence-command "/usr/local/lib/failover-witness/fence-authentik-home-from-oracle.sh --confirm"
EnvironmentFile=/etc/failover-witness/authentik-postgres-fence.env
Environment=AUTHENTIK_HOME_FENCE_KEY=/root/.ssh/pantry-home-fence
Restart=always
RestartSec=5
User=root
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# Enable only after the controlled old-writer fencing and Authentik promotion
# rehearsal passes. The unit remains idle while home holds auth:postgres.

[Install]
WantedBy=multi-user.target
