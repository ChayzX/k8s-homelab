# Install as a systemd drop-in for the local writer service:
#   ChaseBot: /etc/systemd/system/k3s-agent.service.d/pantry-postgres-fence.conf
#   Oracle:   /etc/systemd/system/k3s.service.d/pantry-postgres-fence.conf
# The corresponding self-fence unit must be installed first.
[Unit]
Requires=pantry-postgres-self-fence.service
After=pantry-postgres-self-fence.service
