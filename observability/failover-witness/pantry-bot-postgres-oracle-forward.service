[Unit]
Description=SSH local-forward for the PantryBot home PostgreSQL authority
After=network-online.target failover-witness-oracle-tunnel.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# The home tunnel binds GCP loopback:25432. Oracle exposes its local copy only
# on the node address so the standby pod can reach it through host networking.
ExecStart=/usr/bin/ssh -NT \
  -o BatchMode=yes \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=yes \
  -i /home/ubuntu/.ssh/gcp-witness-oracle \
  -L 100.78.181.15:25432:127.0.0.1:25432 \
  -L 100.78.181.15:25433:127.0.0.1:25433 \
  sa_105559435168833655240@136.113.178.106
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
