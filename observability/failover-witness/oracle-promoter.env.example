# Install as root-owned /etc/failover-witness/postgres-fence.env (0600).
OLD_WRITER_FENCE_COMMAND=/usr/local/lib/failover-witness/fence-canada-from-oracle.sh
LOCAL_WRITER_FENCE_COMMAND=/usr/local/lib/failover-witness/fence-oracle-postgres-local.sh --confirm
REPLICATION_CHECK_COMMAND=/usr/local/lib/failover-witness/oracle-replication-check.sh
SERVICE_CHECK_COMMAND=/usr/local/lib/failover-witness/oracle-service-check.sh
PUBLISH_ROUTES_COMMAND=/usr/local/lib/failover-witness/publish-cloudflare-routes.sh
# Required by fence-canada-from-oracle.sh; keep the key root-only.
# CANADA_ADDRESS=100.104.83.28
# CANADA_ADMIN_KEY=/etc/failover-witness/canada-admin
# CANADA_FENCE_SCRIPT=C:\\ProgramData\\PantryBotCanadaPrep\\fence-canada-writer.ps1
# Isolated Oracle standby-prep database used by the replication gate.
PANTRY_NAMESPACE=pantrybot-canada-replica-prep
PANTRY_STANDBY_POD=canada-standby-prep-0
PANTRY_STANDBY_STATEFULSET=canada-standby-prep
PANTRY_POSTGRES_CONTAINER=postgres
PANTRY_POSTGRES_USER=pantry
PANTRY_POSTGRES_DB=pantry
PANTRY_POSTGRES_PORT=25443
