# Copy this file to a root-owned host-local EnvironmentFile and fill in
# credentials there. Never commit the resulting watcher.env file.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
EXTRA_ALERT_RECIPIENTS=
ALERT_COOLDOWN_SECONDS=86400
OPERATIONS_ALERT_URL=https://operations.example.invalid/api/v1/alerts/events
OPERATIONS_RECONCILE_URL=https://operations.example.invalid/api/v1/alerts/reconcile
OPERATIONS_ALERT_INGEST_SECRET_NAME=operations-alert-ingest
# The legacy pantry-bot Deployment is intentionally scaled to zero. Its public
# commands site is monitored by UptimeRobot; do not probe the retired Service.
FUNCTIONAL_HEALTH_URLS=jmusicbot=http://jmusicbot-health.jmusicbot.svc.cluster.local:9091/health,opsbot=http://opsbot-health.opsbot.svc.cluster.local:9091/health
# Route-specific checks add Discord/Operations context while UptimeRobot remains
# the independent observer when MinecraftMachine itself is unreachable.
EXTERNAL_HEALTH_URLS=commands=https://commands.greeniespantry.uk/api/public/commands,oauth=https://oauth.greeniespantry.uk/login/broadcaster,mods=https://mods.greeniespantry.uk/mod/,overlay=https://overlay.greeniespantry.uk/
PANTRY_BOT_NODE=pantry-bot-oracle
IGNORED_NODES=chasebot
WATCH_NAMESPACES=jmusicbot,pantry-bot,opsbot,ci-tunnel,observability
