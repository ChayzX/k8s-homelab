# Copy to the host-only systemd EnvironmentFile and chmod 0600. Never commit
# real values. Existing Discord, Loki, kubeconfig, and watcher settings remain
# required as documented for the host service.
DISCORD_BOT_TOKEN=replace-me
DISCORD_USER_ID=replace-me

# Operations dual delivery. Leave all five values unset to remain Discord-only.
OPERATIONS_ALERT_URL=https://operations.greeniespantry.uk/api/v1/alerts/events
OPERATIONS_RECONCILE_URL=https://operations.greeniespantry.uk/api/v1/alerts/reconcile
OPERATIONS_ALERT_INGEST_KEY=replace-with-independent-random-secret
OPERATIONS_ALERT_INGEST_SECRET_NAME=operations-alert-ingest
OPERATIONS_CF_ACCESS_CLIENT_ID=replace-with-watcher-service-token-id
OPERATIONS_CF_ACCESS_CLIENT_SECRET=replace-with-watcher-service-token-secret
OPERATIONS_TIMEOUT_SECONDS=3
OPERATIONS_PENDING_LIMIT=200
OPERATIONS_RETRY_BASE_SECONDS=5
PANTRY_BOT_NODE=pantry-bot-oracle
