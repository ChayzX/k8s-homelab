{
  "apiVersion": "v1",
  "kind": "ResourceQuota",
  "metadata": {
    "name": "oracle-ci-global",
    "namespace": "arc-runners"
  },
  "spec": {
    "hard": {
      "pods": "1",
      "requests.cpu": "100m",
      "requests.memory": "512Mi",
      "limits.cpu": "1",
      "limits.memory": "3Gi",
      "requests.ephemeral-storage": "512Mi",
      "limits.ephemeral-storage": "4608Mi",
      "persistentvolumeclaims": "0"
    }
  }
}
